# Mode iklan: off (tanpa iklan, default), test (iklan tiruan), live (iklan nyata)
VITE_ADS_MODE=off

# ID penerbit AdSense, contoh: ca-pub-1234567890123456 (hanya dipakai pada mode test dan live)
VITE_ADSENSE_CLIENT=

# ID unit iklan display (angka) dari AdSense, satu per tempat. Kosong = banner di tempat itu tidak tampil.
VITE_ADSENSE_SLOT_WORLD=
VITE_ADSENSE_SLOT_PLAY=

# Alamat situs untuk canonical, Open Graph, sitemap, dan robots.txt (tanpa garis miring di akhir)
VITE_SITE_URL=http://localhost:5173